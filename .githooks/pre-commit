#!/usr/bin/env bash
# Блокирует коммит staged-файлов крупнее MAX_TOKENS (1 токен = 4 байта).
# Включение: git config core.hooksPath .githooks
set -euo pipefail

MAX_TOKENS=5000
BYTES_PER_TOKEN=4
MAX_BYTES=$((MAX_TOKENS * BYTES_PER_TOKEN))

# Не написано агентами: lock-файлы, сгенерированный код, снапшоты, минифицированные ассеты.
# Grandfathered: большие файлы, существовавшие до введения гейта; гейт
# применяется к новым файлам, а не к аддитивным правкам в этих.
IGNORE_RE='(^|/)(Cargo\.lock|package-lock\.json|pnpm-lock\.yaml|yarn\.lock|poetry\.lock|uv\.lock|go\.sum)$|\.lock$|\.snap$|^planning/tasks/queue\.yaml$|^bins/agentd/src/execution\.rs$|^bins/agentd/src/lib\.rs$|^bins/agentctl/src/(lib|main)\.rs$|^bins/agentctl/tests/execution_binaries\.rs$|^bins/agentd/tests/(execution_recovery|live_ownership)\.rs$|^bins/agentctl/tests/execution_(recovery|composition)\.rs$|^crates/app-services/src/(orchestration|planning)_service\.rs$|^crates/app-services/tests/planning_service\.rs$|^adapters/provider-claude/src/planner\.rs$|^adapters/storage-sqlite/src/(plan|task)_store\.rs$|^adapters/storage-sqlite/tests/(durability|journal|observed_effects|plan_persistence|runtime|security_audit)\.rs$|^crates/app-services/tests/(failure_matrix|orchestration|provider_binding)\.rs$|^crates/task/src/task\.rs$|^crates/evaluation/src/(candidate|claim_verification)\.rs$|^bins/agentd/src/dispatch\.rs$|^crates/app-services/src/(task_service|verification_execution)\.rs$|^crates/plan/(src/(model|validation)|tests/validation_rules)\.rs$|^crates/ipc-contracts/src/lib\.rs$|^crates/ipc-control/src/(negotiation|session)\.rs$|^adapters/(effect-capture-local|finder-local)/src/lib\.rs$|^adapters/provider-claude/src/(environment|process)\.rs$|^adapters/runner-macos-seatbelt/src/lib\.rs$|^adapters/secrets-vault/src/backend\.rs$|^apps/desktop/src-tauri/src/live_metrics\.rs$|^bins/agentctl/tests/task_core_matrix\.rs$|^bins/agentd/src/(planning|vault|widget|user_presence_dispatch_tests)\.rs$|^crates/ipc-transport/src/platform/(unix|windows)\.rs$|^crates/runner/src/lib\.rs$|\.(md|mdx)$|\.min\.(js|css)$|\.pb\.(go|rs)$|\.pb\.h$|_pb2(_grpc)?\.pyi?$|(^|/)(generated|gen|vendor|target|node_modules)/|\.generated\.[a-z]+$|\.(png|jpe?g|gif|webp|ico|pdf|woff2?|zip|gz)$'

fail=0
while IFS= read -r -d '' f; do
  [[ "$f" =~ $IGNORE_RE ]] && continue
  bytes=$(git cat-file -s ":$f")   # размер staged-версии, не рабочей копии
  if (( bytes > MAX_BYTES )); then
    tokens=$((bytes / BYTES_PER_TOKEN))
    parts=$(( (tokens + MAX_TOKENS - 1) / MAX_TOKENS ))
    {
      echo "ERROR: $f — ~${tokens} токенов (${bytes} байт), лимит ${MAX_TOKENS} (${MAX_BYTES} байт)."
      echo "  Как исправить: разбейте файл минимум на ${parts} части по ~${MAX_TOKENS} токенов:"
      echo "    1. Найдите границы по смыслу (модули, типы, группы функций, разделы документа)."
      echo "    2. Вынесите каждую часть в отдельный файл рядом, имя по содержимому."
      echo "       Rust: mod foo; в исходном файле + foo.rs (или каталог foo/ с mod.rs)."
      echo "       Тесты: tests/<тема>.rs. Markdown/YAML: файл-индекс со ссылками на части."
      echo "    3. В исходном файле оставьте только реэкспорты/ссылки на части."
      echo "    4. Проверьте сборку/тесты, затем: git add <новые файлы> $f"
      echo "  Если файл не пишется агентом (генерация, данные) — добавьте его в IGNORE_RE в .githooks/pre-commit."
    } >&2
    fail=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

exit $fail
