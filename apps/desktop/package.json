{
  "name": "runlith-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "tauri": "tauri",
    "bindings": "cd src-tauri && cargo test --lib",
    "maps": "node scripts/gen-maps.ts",
